<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:background="@drawable/bg_dialog_rounded">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 顶部彩色头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <ImageView
        android:id="@+id/in_app_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="centerCrop"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0.4"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 关于项（点击展开） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_about_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_circle_green"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_header"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_about_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="0dp"
            android:textColor="#666666"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginStart="56dp" />
    </LinearLayout>

    <!-- 【设置项】点击展开四个选项 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_settings_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_circle_blue"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_header"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_settings_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 【设置内容】四个选项 -->
        <LinearLayout
            android:id="@+id/layout_settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="0dp"
            android:visibility="gone">

            <!-- 1. 文件操作多线程 -->
            <CheckBox
                android:id="@+id/cb_dialog_multithread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box_enable_multi_thread_acceleration"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_io_multithread"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/layout_io_thread_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="32dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_thread_count"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sp_io_thread_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 2. 拼图生成多线程 -->
            <CheckBox
                android:id="@+id/cb_dialog_puzzle_multithread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box_puzzle_multithread"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_puzzle_multithread"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/layout_puzzle_thread_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="32dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_thread_count"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sp_puzzle_thread_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 草稿箱：自动保存 -->
            <CheckBox
                android:id="@+id/cb_draft_autosave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box_draft_autosave"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_draft_autosave"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp" />

            <!-- 间隔 + 单位 -->
            <LinearLayout
                android:id="@+id/layout_draft_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_draft_interval"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sp_draft_interval"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content" />

                <Spinner
                    android:id="@+id/sp_draft_interval_unit"
                    android:layout_width="wrap_content"
                    android:minWidth="72dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 草稿数量上限 -->
            <LinearLayout
                android:id="@+id/layout_draft_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_draft_max"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sp_draft_max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 同时保存改动前的原始数据（用于对比） -->
            <CheckBox
                android:id="@+id/cb_draft_keep_original"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box_draft_keep_original"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_draft_keep_original"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingStart="32dp"
                android:layout_marginBottom="14dp" />

            <!-- 回收站自动清理 -->
            <LinearLayout
                android:id="@+id/layout_trash_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="32dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_trash_keep"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/sp_trash_keep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_trash_keep"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingStart="32dp"
                android:layout_marginBottom="14dp" />

            <!-- 3. Shizuku -->
            <CheckBox
    android:id="@+id/cb_skip_shizuku"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/box_skip_shizuku"
    android:textSize="14sp"
    android:layout_marginBottom="12dp" />

            <!-- 5. 迁移旧数据（NbtEditor_Data → Nibnya） -->
            <Button
                android:id="@+id/btn_migrate_data"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/label_migrate_settings"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:layout_marginBottom="8dp" />

            <!-- 6. 日夜模式 -->
            <Button
                android:id="@+id/btn_dialog_theme"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/action_switch_night"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:layout_marginBottom="8dp" />

            <!-- 7. 语言 -->
            <Button
                android:id="@+id/btn_dialog_lang"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Switch to English"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</ScrollView>