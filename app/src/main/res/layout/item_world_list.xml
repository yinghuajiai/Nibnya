<?xml version="1.0" encoding="utf-8"?>
<!--
  存档列表单项：左侧 world_icon.jpeg 正方形缩略图，右侧三行文字。

  缩略图区域是固定 56x56 的方块（FrameLayout）：
    · 有图  -> 显示截图，隐藏占位文字
    · 没图  -> 隐藏截图，显示「无预览图」提示文字
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_world_icon">

        <ImageView
            android:id="@+id/iv_world_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_world_icon_none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/msg_no_world_icon"
            android:textSize="8sp"
            android:textColor="@color/app_text_tertiary"
            android:gravity="center"
            android:padding="3dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ① 世界名：长了就换行（最多 3 行），不再被省略号吃掉 -->
        <TextView
            android:id="@+id/tv_world_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/app_text_primary"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- ② 文件夹 ID：一行，超出时中间省略（尾部 = 号要能看到） -->
        <TextView
            android:id="@+id/tv_world_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/app_text_tertiary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <!-- ③ 最后游玩时间：单独一行，绝不被上面两行挤掉 -->
        <TextView
            android:id="@+id/tv_world_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/app_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
